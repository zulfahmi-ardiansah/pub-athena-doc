# Application Settings
APP_NAME="Athena Document Extractor"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Engine Selection: "local_cpu" | "cloud_google"
ENGINE_BACKEND="local_cpu"

# Enable Interactive Browser Demo UI at / or /demo
ENABLE_DEMO=true

# OCR Engine
## "rapidocr" | "tesseract"
OCR_ENGINE="rapidocr"
## (Optional: Custom Path)
OCR_TESSERACT_EXECUTABLE=""

# Ollama Settings
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:3b"
OLLAMA_TIMEOUT_SECONDS=60.0
OLLAMA_KEEP_ALIVE="-1"
OLLAMA_PRELOAD=true

# Cloud Engine (Google Gemini) Settings
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# File Upload Constraints
MAX_FILE_SIZE_MB=15
