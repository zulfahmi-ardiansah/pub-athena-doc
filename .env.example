# ==============================================================================
#                 ATHENA DOCUMENT EXTRACTOR - CONFIGURATION
# ==============================================================================
# Copy this file to '.env' and adjust variables according to your environment.
# All environment variables are strictly validated by Pydantic BaseSettings.
# ==============================================================================


# ==============================================================================
# 1. CORE APPLICATION & SERVER RUNTIME
# ==============================================================================
# Service name displayed in Swagger docs and OpenTelemetry metadata
APP_NAME="Athena Document Extractor"

# Development mode (enables verbose errors and reload triggers)
# [Type: boolean | Choices: true, false | Default: true]
DEBUG=true

# Host and port binding for ASGI server (Uvicorn)
HOST="0.0.0.0"
PORT=8000

# Mount interactive HTML demo interface at '/' and '/demo'
# [Type: boolean | Choices: true, false | Default: true]
ENABLE_DEMO=true

# Maximum allowable file upload size in Megabytes
# [Type: integer | Default: 15]
MAX_FILE_SIZE_MB=15

# Local filesystem directory for storing execution debug artifacts
TRACE_DIR="trace"

# Whether to keep trace folder on disk after successful extractions
# [Type: boolean | Choices: true, false | Default: false]
KEEP_TRACE_ARTIFACTS=false


# ==============================================================================
# 2. EXTRACTION ENGINE & PIPELINE ORCHESTRATION
# ==============================================================================
# Primary Engine Architecture:
# - "hybrid_engine" : Multi-stage pipeline (Digital PDF -> OCR -> Visual LLM) with confidence fallback
# - "visual_engine" : Direct multimodal LLM vision analysis on full document images
# - "string_engine" : Classical regex/deterministic parser on digital/OCR text
# [Type: string | Choices: "hybrid_engine", "visual_engine", "string_engine" | Default: "hybrid_engine"]
ENGINE_TYPE="hybrid_engine"

# Ordered sequence of extraction stages attempted in hybrid_engine
# Comma-separated list: "digital_pdf", "ocr", "visual_llm"
# [Type: comma-separated string | Default: "digital_pdf,ocr,visual_llm"]
EXTRACTION_PIPELINE="digital_pdf,ocr,visual_llm"

# Minimum extractor confidence score (0.0 to 1.0) before cascading to next stage
# [Type: float | Default: 0.5]
EXTRACTION_MIN_CONFIDENCE=0.5

# Downstream structured data extraction analyzer mode:
# - "text_llm" : Schema-guided LLM structured JSON generation
# - "string"   : Fast, deterministic regex-based rule extractor
# [Type: string | Choices: "text_llm", "string" | Default: "text_llm"]
ANALYSIS_MODE="text_llm"


# ==============================================================================
# 3. IMAGE PREPROCESSING & ENHANCEMENT
# ==============================================================================
# Enable computer vision pre-processing pipeline for scanned documents & photos
# [Type: boolean | Choices: true, false | Default: true]
IMAGE_PREPROCESS=true

# Correct rotational skew and angle misalignment via OpenCV
# [Type: boolean | Choices: true, false | Default: true]
IMAGE_DESKEW=true

# Automatic contrast enhancement and histogram equalization
# [Type: boolean | Choices: true, false | Default: true]
IMAGE_ENHANCE_CONTRAST=true

# Binarization thresholding mode for OCR readability
# [Type: string | Choices: "none", "otsu", "adaptive" | Default: "none"]
IMAGE_THRESHOLD_MODE="none"

# Image enhancement parameters
IMAGE_ENHANCE_GAMMA=1.15
IMAGE_ENHANCE_WHITE_CUTOFF=230
IMAGE_ENHANCE_BLACK_LEVEL=25

# Rendering DPI when converting PDF pages to raster images
# [Type: integer | Default: 150]
IMAGE_RENDER_DPI=150


# ==============================================================================
# 4. OCR BACKEND CONFIGURATION
# ==============================================================================
# OCR Engine used by the "ocr" extraction stage:
# - "rapidocr"     : CPU-optimized ONNX Runtime OCR (lightweight, recommended)
# - "tesseract"    : Google Tesseract OCR engine (requires system binary)
# - "google_vision": Google Cloud Vision API
# [Type: string | Choices: "rapidocr", "tesseract", "google_vision" | Default: "rapidocr"]
OCR_BACKEND="rapidocr"

# Custom path to Tesseract binary (leave empty if available in system PATH)
# Example (Windows): "C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
# Example (Linux):   "/usr/bin/tesseract"
TESSERACT_CMD=""


# ==============================================================================
# 5. LLM PROVIDERS & MODEL CONFIGURATION
# ==============================================================================
# Independent provider selection for Text Analysis and Vision Extraction:
# [Type: string | Choices: "ollama", "google", "openai" | Default: "ollama"]
LLM_TEXT_PROVIDER="ollama"
LLM_VISION_PROVIDER="ollama"

# Global fallback provider if LLM_TEXT_PROVIDER or LLM_VISION_PROVIDER is unset
LLM_PROVIDER="ollama"

# ------------------------------------------------------------------------------
# 5A. Ollama (Local Self-Hosted LLM)
# ------------------------------------------------------------------------------
# Base URL of the local Ollama server
OLLAMA_BASE_URL="http://localhost:11434"

# Model identifiers used for text analysis and vision extraction
OLLAMA_TEXT_MODEL="qwen2.5:3b"
OLLAMA_VISION_MODEL="llama3.2-vision"

# Request timeout in seconds
OLLAMA_TIMEOUT_SECONDS=60.0

# How long to keep the model loaded in memory after last use
# "-1" = keep loaded indefinitely | "0" = unload immediately | e.g. "5m", "1h" = duration
OLLAMA_KEEP_ALIVE="-1"

# Preload/warm the model into memory (RAM/VRAM) on application startup
# [Type: boolean | Choices: true, false | Default: true]
OLLAMA_PRELOAD=true

# ------------------------------------------------------------------------------
# 5B. Google Cloud & Gemini / Vertex AI
# ------------------------------------------------------------------------------
# API key for Google AI Studio / Gemini API (leave empty to use Vertex AI auth instead)
GOOGLE_API_KEY=""

# GCP Project ID for Vertex AI mode (leave empty to auto-resolve from gcloud ADC, if available)
GOOGLE_PROJECT_ID=""

# Vertex AI region/location
# Examples: "global" | "us-central1" | "asia-southeast1"
GOOGLE_LOCATION="global"

# Path to a Service Account JSON credentials file (leave empty to use API key or ambient gcloud ADC)
GOOGLE_APPLICATION_CREDENTIALS=""

# Model identifiers used for text analysis and vision extraction
GOOGLE_TEXT_MODEL="gemma-4-26b-a4b-it-maas"
GOOGLE_VISION_MODEL="gemma-4-26b-a4b-it-maas"

# ------------------------------------------------------------------------------
# 5C. OpenAI / OpenAI-Compatible (OpenAI, OpenRouter, vLLM, LM Studio, Groq, etc.)
# ------------------------------------------------------------------------------
# API key for the target endpoint (leave empty for local servers that don't require one)
OPENAI_API_KEY=""

# Base URL of the OpenAI-compatible Chat Completions API
# Examples: "https://api.openai.com/v1" | "https://openrouter.ai/api/v1" | "http://localhost:1234/v1"
OPENAI_BASE_URL="https://api.openai.com/v1"

# Model identifiers used for text analysis and vision extraction
# (OpenRouter-style prefixed IDs, e.g. "openai/gpt-4o-mini", are also accepted)
OPENAI_TEXT_MODEL="gpt-4o-mini"
OPENAI_VISION_MODEL="gpt-4o-mini"

# Request timeout in seconds
OPENAI_TIMEOUT_SECONDS=60.0


# ==============================================================================
# 6. STANDARDIZED LOGGING & PERSONAL INFORMATION (PI) PRIVACY
# ==============================================================================
# Application log severity threshold
# [Type: string | Choices: "DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL" | Default: "INFO"]
LOG_LEVEL="INFO"

# Local directory where physical rotated log files are written
# [Type: string | Default: "logs"]
LOG_DIR="logs"

# Log output format:
# - "json" : Newline-delimited JSON Lines (structured for ELK, Vector, Loki, CloudWatch)
# - "text" : Human-readable colored console stream for local terminal development
# [Type: string | Choices: "json", "text" | Default: "json"]
LOG_FORMAT="json"

# Enable physical tiered log files:
# 1. logs/app.log    -> All application events
# 2. logs/error.log  -> WARNING, ERROR, and CRITICAL events
# 3. logs/access.log -> Structured HTTP access entries
# [Type: boolean | Choices: true, false | Default: true]
LOG_TO_FILE=true

# Maximum days to retain rotated log files before automatic deletion
# [Type: integer | Default: 30]
LOG_RETENTION_DAYS=30

# Automatic multi-layer regex masking for Personal Information (PI):
# Redacts National IDs (NIK/KK), Tax Numbers (NPWP), Phone numbers, Emails,
# Payment Card numbers, and Bearer / API auth tokens in all logs & stack traces.
# [Type: boolean | Choices: true, false | Default: true]
PI_MASKING_ENABLED=true


# ==============================================================================
# 7. OPENTELEMETRY (OTEL) & DISTRIBUTED TRACING
# ==============================================================================
# Enable OpenTelemetry distributed tracing and W3C context propagation
# [Type: boolean | Choices: true, false | Default: false]
OTEL_ENABLED=false

# Service identifier for distributed trace aggregators
OTEL_SERVICE_NAME="athena-doc-extractor"
OTEL_SERVICE_VERSION="0.2.0"

# OTLP Collector endpoint (e.g., Jaeger, Grafana Tempo, SigNoz, Datadog)
# Example gRPC: "http://localhost:4317"
# Example HTTP: "http://localhost:4318/v1/traces"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"

# OTLP protocol transport
# [Type: string | Choices: "grpc", "http/protobuf" | Default: "grpc"]
OTEL_EXPORTER_OTLP_PROTOCOL="grpc"

# Trace sampling ratio (1.0 = 100% of requests sampled, 0.1 = 10% sampled)
# [Type: float | Range: 0.0 to 1.0 | Default: 1.0]
OTEL_SAMPLE_RATE=1.0
