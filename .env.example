# Application Settings
APP_NAME="Athena Document Extractor"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Engine Selection: "ocr_hybrid" | "visual_model" | "cloud_google"
ENGINE_BACKEND="ocr_hybrid"

# Enable Interactive Browser Demo UI at / or /demo
ENABLE_DEMO=true

# OCR Engine (used by ocr_hybrid)
## "rapidocr" | "tesseract"
OCR_ENGINE="rapidocr"
## (Optional: Custom Path)
TESSERACT_CMD=""

# OCR Image Preprocessing (thresholding, deskewing, contrast enhancement, tone curve)
OCR_PREPROCESS=true
OCR_DESKEW=true
OCR_ENHANCE_CONTRAST=true
## "none" | "otsu" | "adaptive"
OCR_THRESHOLD_MODE="none"
OCR_ENHANCE_GAMMA=1.15
OCR_ENHANCE_WHITE_CUTOFF=230
OCR_ENHANCE_BLACK_LEVEL=25

# Ollama Settings (used by ocr_hybrid and visual_model)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:3b"
OLLAMA_VISION_MODEL="llama3.2-vision"
OLLAMA_TIMEOUT_SECONDS=60.0
OLLAMA_KEEP_ALIVE="-1"
OLLAMA_PRELOAD=true

# Cloud Engine (Google Gemini) Settings
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# File Upload Constraints
MAX_FILE_SIZE_MB=15
