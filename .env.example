# ==============================================================================
# 1. CORE APPLICATION & ENGINE CONFIGURATION
# ==============================================================================
APP_NAME="Athena Document Extractor"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
ENABLE_DEMO=true
MAX_FILE_SIZE_MB=15
TRACE_DIR="trace"

# Primary Engine: "string_engine" | "visual_engine" | "hybrid_engine"
ENGINE_TYPE="hybrid_engine"

# ==============================================================================
# 2. WORKFLOW & PIPELINE CONFIGURATION (used by hybrid_engine)
# ==============================================================================
# Extraction stages executed in order until confidence >= EXTRACTION_MIN_CONFIDENCE
# Available stages: "digital_pdf", "ocr", "visual_llm"
EXTRACTION_PIPELINE="digital_pdf,ocr,visual_llm"
EXTRACTION_MIN_CONFIDENCE=0.5

# Analysis Mode: "llm" (structured JSON generation) | "string" (deterministic regex parser)
ANALYSIS_MODE="llm"

# ==============================================================================
# 3. IMAGE PREPROCESSING
# ==============================================================================
IMAGE_PREPROCESS=true
IMAGE_DESKEW=true
IMAGE_ENHANCE_CONTRAST=true
IMAGE_THRESHOLD_MODE="none"            # "none" | "otsu" | "adaptive"
IMAGE_ENHANCE_GAMMA=1.15
IMAGE_ENHANCE_WHITE_CUTOFF=230
IMAGE_ENHANCE_BLACK_LEVEL=25
IMAGE_RENDER_DPI=150

# ==============================================================================
# 4. OCR EXTRACTION BACKEND
# ==============================================================================
# OCR Engine: "rapidocr" | "tesseract" | "google_vision"
OCR_BACKEND="rapidocr"
TESSERACT_CMD=""

# ==============================================================================
# 5. LLM PROVIDER & MODEL CONFIGURATION
# ==============================================================================
# Default LLM Provider: "ollama" | "google"
LLM_PROVIDER="ollama"

# --- Ollama (Local) ---
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_TEXT_MODEL="qwen2.5:3b"
OLLAMA_VISION_MODEL="llama3.2-vision"
OLLAMA_TIMEOUT_SECONDS=60.0
OLLAMA_KEEP_ALIVE="-1"
OLLAMA_PRELOAD=true

# --- Google (Cloud / Gemini / Vertex AI / Cloud Vision) ---
GOOGLE_API_KEY=""
GOOGLE_PROJECT_ID=""
GOOGLE_LOCATION="global"
GOOGLE_APPLICATION_CREDENTIALS=""
GOOGLE_TEXT_MODEL="gemma-4-26b-a4b-it-maas"
GOOGLE_VISION_MODEL="gemma-4-26b-a4b-it-maas"
