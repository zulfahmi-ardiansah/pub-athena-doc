# ==============================================================================
# Development Override Configuration (docker-compose.override.yml)
# ==============================================================================
# To use this in development:
#   cp docker-compose.override.yml.example docker-compose.override.yml
#   docker compose up --build
#
# This enables:
#   1. Live reload on code changes in src/
#   2. Volume mounting of local source code into container
# ==============================================================================

services:
  athena-api:
    command: ["uvicorn", "src.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
    volumes:
      - ./src:/app/src:ro
    environment:
      DEBUG: "true"
